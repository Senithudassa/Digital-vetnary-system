rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------------------------------------------------------
    // HELPER FUNCTIONS
    // ------------------------------------------------------------------------
    
    // Check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check specific custom claims assigned via Zero Trust Backend
    function isMainAdmin() {
      return isAuthenticated() && request.auth.token.role == 'main_admin';
    }
    
    function isMinorAdmin() {
      return isAuthenticated() && request.auth.token.role == 'minor_admin';
    }
    
    function isVetBranch() {
      return isAuthenticated() && request.auth.token.role == 'vet';
    }
    
    function isCustomer() {
      return isAuthenticated() && request.auth.token.role == 'customer';
    }

    // ------------------------------------------------------------------------
    // COLLECTION RULES
    // ------------------------------------------------------------------------
    
    // USERS COLLECTION (Customers & Staff Profiles)
    match /users/{userId} {
      // Users can read/write their own profile. Main Admins can do anything.
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isMainAdmin());
      // Vets and Minor Admins can read (to service requests) but not edit other profiles.
      allow read: if isMinorAdmin() || isVetBranch();
    }
    
    // PETS COLLECTION (Network-wide Pet Profiles)
    match /pets/{petId} {
      // Anyone authenticated can search/read to service a pet IF they have the Account Number (handled by query filters)
      allow read: if isAuthenticated(); 
      // Only the Owner or a Main Admin can edit/delete a pet profile
      allow write: if isAuthenticated() && (request.auth.uid == resource.data.owner_uid || isMainAdmin());
      // Creating a pet requires you to be the specified owner
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.owner_uid;
    }

    // CLINICS COLLECTION (Vet Branches & Financials)
    match /clinics/{branchId} {
      // Vets can read their own clinic. Minor admins can read public data. Main admins can read all.
      // (Financial hashing protects data from Minor Admins even if they have read access)
      allow read: if isAuthenticated(); 
      // STRICT WRITE LOCK: Only Main Admins can edit Clinic records (Discount Tiers, Hashes, etc.)
      // Vets CANNOT alter their own financial metrics once set by the system.
      allow write: if isMainAdmin();
    }

    // APPOINTMENTS COLLECTION
    match /appointments/{apptId} {
      // Customers can read/create their own appointments
      // Vets can read/update appointments for THEIR branch
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.owner_uid || // Customer owns it
        (isVetBranch() && request.auth.token.branch_id == resource.data.branch_id) || // Vet Branch owns it
        isMainAdmin() || isMinorAdmin() // Admins overview
      );
      
      allow create: if isAuthenticated(); // Anyone can create an appointment
      
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.owner_uid || 
        (isVetBranch() && request.auth.token.branch_id == resource.data.branch_id) ||
        isMainAdmin()
      );
      
      allow delete: if isMainAdmin(); // Soft deletes preferred, only Main Admin hard deletes
    }

    // SUPPORT TICKETS (Minor Admin Contact Center)
    match /support_tickets/{ticketId} {
      // Customers can read their own
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.owner_uid ||
        isMinorAdmin() || isMainAdmin() ||
        (isVetBranch() && resource.data.target_branch_id == request.auth.token.branch_id)
      );
      
      allow write: if isAuthenticated() && (
        request.auth.uid == resource.data.owner_uid || // Create/Update own ticket
        isMinorAdmin() || isMainAdmin() || // Admins working the queue
        (isVetBranch() && resource.data.target_branch_id == request.auth.token.branch_id) // Vet responding to a routed ticket
      );
    }

    // STAGING COMMITS (Main Admin Authorization Queue)
    match /staging_commits/{commitId} {
      // Only Admins can view the staging queue
      allow read: if isMinorAdmin() || isMainAdmin();
      // Minor Admins can CREATE proposals. ONLY Main Admins can UPDATE/APPROVE them.
      allow create: if isMinorAdmin();
      allow update, delete: if isMainAdmin();
    }

    // GLOBAL FALLBACK LOCK
    match /{document=**} {
      // If a collection isn't explicitly defined above, NO ONE can access it by default. (Zero Trust)
      allow read, write: if false;
    }
    
  }
}
